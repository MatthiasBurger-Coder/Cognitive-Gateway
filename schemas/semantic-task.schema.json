{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-gateway.local/schemas/semantic-task/v1/task.schema.json",
  "title": "SemanticTaskIR 1.0",
  "$comment": "Rust enforces identity uniqueness, scope equality, homogeneous typed sets, CG-06 predicates and exact version support. External reference validation remains required.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "task_type": {
      "enum": [
        "ANALYZE",
        "ANALYZE_PERFORMANCE",
        "INSPECT",
        "CREATE",
        "MODIFY",
        "VERIFY"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "SERVICE",
            "ARTIFACT",
            "PROJECT",
            "ENTITY"
          ]
        },
        "reference": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "outcome",
        "description"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      },
      "uniqueItems": true
    },
    "context_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "uniqueItems": true
    },
    "current_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "type": "null"
        }
      ]
    },
    "desired_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/desired_state"
        },
        {
          "type": "null"
        }
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "uniqueItems": true
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "uniqueItems": true
    },
    "capability_requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      },
      "uniqueItems": true
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "uniqueItems": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      },
      "uniqueItems": true
    },
    "output_contract": {
      "type": "object",
      "properties": {
        "schema": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "schema"
      ],
      "additionalProperties": false
    },
    "verification_contract": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "OUTPUT_SCHEMA_VALID",
              "EVIDENCE_REQUIRED",
              "ALL_CLAIMS_SUPPORTED",
              "NO_UNRESOLVED_REFERENCE"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "OUTPUT_SCHEMA_VALID"
              }
            },
            {
              "contains": {
                "const": "NO_UNRESOLVED_REFERENCE"
              }
            }
          ]
        }
      },
      "required": [
        "checks"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "checks": {
                "contains": {
                  "const": "ALL_CLAIMS_SUPPORTED"
                }
              }
            }
          },
          "then": {
            "properties": {
              "checks": {
                "contains": {
                  "const": "EVIDENCE_REQUIRED"
                }
              }
            }
          }
        }
      ]
    },
    "process": {
      "anyOf": [
        {
          "$ref": "#/$defs/process"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "task_type",
    "target",
    "goal",
    "inputs",
    "context_refs",
    "observations",
    "history",
    "capability_requirements",
    "constraints",
    "policy_refs",
    "evidence_refs",
    "assumptions",
    "output_contract",
    "verification_contract"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "[^\\s]"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "$ref": "#/$defs/id"
        },
        "contract": {
          "$ref": "#/$defs/id"
        },
        "contract_version": {
          "$ref": "#/$defs/version"
        },
        "revision": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "id",
        "scope",
        "contract",
        "contract_version",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "scalar": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "BOOLEAN"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "INTEGER"
            },
            "value": {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "DECIMAL"
            },
            "value": {
              "type": "object",
              "properties": {
                "unscaled": {
                  "type": "string",
                  "pattern": "^-?[0-9]+$"
                },
                "scale": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18
                }
              },
              "required": [
                "unscaled",
                "scale"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "STRING"
            },
            "value": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "SYMBOL"
            },
            "value": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "BOOLEAN"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "INTEGER"
            },
            "value": {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "DECIMAL"
            },
            "value": {
              "type": "object",
              "properties": {
                "unscaled": {
                  "type": "string",
                  "pattern": "^-?[0-9]+$"
                },
                "scale": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18
                }
              },
              "required": [
                "unscaled",
                "scale"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "STRING"
            },
            "value": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "SYMBOL"
            },
            "value": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "SET"
            },
            "value": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/scalar"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "CONDITION"
            },
            "value": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ALL"
            },
            "value": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "ANY"
            },
            "value": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "NOT"
            },
            "value": {
              "$ref": "#/$defs/expression"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "subject": {
          "$ref": "#/$defs/text"
        },
        "operator": {
          "enum": [
            "EQUALS",
            "NOT_EQUALS",
            "GREATER_THAN",
            "GREATER_OR_EQUAL",
            "LESS_THAN",
            "LESS_OR_EQUAL",
            "IN",
            "CONTAINS",
            "PRESENT",
            "ABSENT"
          ]
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "subject",
        "operator"
      ],
      "additionalProperties": false
    },
    "desired_state": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declarative_constraint"
          },
          "uniqueItems": true
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptance_criterion"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "id",
        "conditions",
        "expression",
        "constraints",
        "acceptance_criteria"
      ],
      "additionalProperties": false
    },
    "declarative_constraint": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        }
      },
      "required": [
        "id",
        "expression"
      ],
      "additionalProperties": false
    },
    "acceptance_criterion": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        }
      },
      "required": [
        "id",
        "description",
        "expression"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/id"
        },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "LITERAL"
                },
                "value": {
                  "$ref": "#/$defs/value"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "REFERENCE"
                },
                "value": {
                  "$ref": "#/$defs/reference"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "role",
        "value"
      ],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "FEATURE_FREEZE",
            "LIVE_MUTATION_REQUIRES_CONSENT",
            "REQUIRE_FULL_PATH_FOR_RELEASE_QUALIFICATION"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "premise": {
          "$ref": "#/$defs/value"
        },
        "basis": {
          "$ref": "#/$defs/reference"
        },
        "confidence": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "UNKNOWN"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "NOT_APPLICABLE"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "SCORE"
                },
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "premise",
        "basis",
        "confidence"
      ],
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "additionalProperties": false
    }
  }
}
