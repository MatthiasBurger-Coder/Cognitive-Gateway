{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-gateway.dev/schemas/skill.schema.json",
  "title": "Cognitive Gateway Skill and Capability Definition",
  "description": "The strict v2 self-contained contract for a reusable Skill and its optional provided capability contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "name",
    "description",
    "authoritative_sources",
    "rules",
    "verification",
    "requires",
    "related_skills"
  ],
  "properties": {
    "schema_version": {
      "const": 2,
      "description": "The only supported self-contained skill-document schema version."
    },
    "kind": {
      "const": "skill"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "$ref": "#/$defs/description",
      "description": "Human-readable name of the skill."
    },
    "description": {
      "$ref": "#/$defs/description"
    },
    "owner_agent_id": {
      "anyOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ],
      "description": "Optional typed AgentId ownership relationship."
    },
    "authoritative_sources": {
      "type": "array",
      "description": "Declarative source selectors or patterns used to apply the skill.",
      "items": { "$ref": "#/$defs/description" }
    },
    "rules": {
      "type": "array",
      "description": "Declarative rules and instructions belonging to the skill.",
      "items": { "$ref": "#/$defs/description" }
    },
    "verification": {
      "type": "array",
      "description": "Declarative verification guidance belonging to the skill.",
      "items": { "$ref": "#/$defs/description" }
    },
    "requires": {
      "type": "array",
      "description": "Ordered, unique mandatory SkillId dependencies. Cycles are rejected by the registry.",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "related_skills": {
      "type": "array",
      "description": "Ordered, unique optional or related SkillId references.",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "required_capability_ids": {
      "type": "array",
      "description": "Ordered, unique abstract CapabilityId requirements; these do not grant permission.",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "knowledge_queries": {
      "type": "array",
      "description": "Ordered retrieval hints represented by KnowledgeQuery values.",
      "items": { "$ref": "#/$defs/description" }
    },
    "provided_capabilities": {
      "type": "array",
      "description": "Reusable capabilities directly provided by this Skill; this is not execution authority.",
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S",
      "description": "Required non-whitespace text; domain validation also rejects disallowed control characters."
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "domain",
        "description",
        "input_kinds",
        "output_kinds",
        "preconditions",
        "constraints",
        "applicability_tags"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "class": { "enum": ["INSPECT", "MUTATE"] },
        "domain": { "$ref": "#/$defs/identifier" },
        "description": { "$ref": "#/$defs/description" },
        "input_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "output_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "preconditions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "applicability_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}
