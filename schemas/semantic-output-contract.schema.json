{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/output"
    },
    {
      "$ref": "#/$defs/verification"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "$ref": "#/$defs/id"
        },
        "contract": {
          "$ref": "#/$defs/id"
        },
        "contract_version": {
          "$ref": "#/$defs/version"
        },
        "revision": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "id",
        "scope",
        "contract",
        "contract_version",
        "revision",
        "digest"
      ],
      "additionalProperties": false
    },
    "output_type": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "STRING"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "BOOLEAN"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "INTEGER"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "NUMBER"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ARRAY"
            },
            "items": {
              "$ref": "#/$defs/output_type"
            }
          },
          "required": [
            "type",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "OBJECT"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "value_type": {
                    "$ref": "#/$defs/output_type"
                  }
                },
                "required": [
                  "required",
                  "value_type"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "fields"
          ],
          "additionalProperties": false
        }
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "schema": {
          "$ref": "#/$defs/reference"
        },
        "shape": {
          "$ref": "#/$defs/output_type"
        }
      },
      "required": [
        "schema_version",
        "schema",
        "shape"
      ],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "check": {
          "enum": [
            "OUTPUT_SCHEMA_VALID",
            "EVIDENCE_REQUIRED",
            "ALL_CLAIMS_SUPPORTED",
            "NO_UNRESOLVED_REFERENCE"
          ]
        },
        "rule": {
          "$ref": "#/$defs/reference"
        },
        "verifier": {
          "$ref": "#/$defs/reference"
        }
      },
      "required": [
        "check",
        "rule",
        "verifier"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          },
          "minItems": 2
        }
      },
      "required": [
        "schema_version",
        "rules"
      ],
      "additionalProperties": false
    }
  }
}
