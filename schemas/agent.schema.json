{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-gateway.dev/schemas/agent.schema.json",
  "title": "Cognitive Gateway Agent Definition",
  "description": "The strict v1 repository contract for an agent responsibility definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "description",
    "skill_ids",
    "origin"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0",
      "description": "The only supported agent-document schema version."
    },
    "kind": {
      "const": "agent"
    },
    "id": {
      "$ref": "#/$defs/identifier"
    },
    "description": {
      "$ref": "#/$defs/description"
    },
    "skill_ids": {
      "type": "array",
      "description": "Ordered, unique SkillId references required by this agent.",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "origin": {
      "$ref": "#/$defs/origin"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "description": "The CG-02 identifier grammar: ASCII alphanumeric edges and ASCII identifier punctuation inside.",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S",
      "description": "Required non-whitespace text; domain validation also rejects disallowed control characters."
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "source", "migration_status"],
      "properties": {
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S",
          "description": "Source project or repository name."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384,
          "pattern": "\\S",
          "description": "Original repository path or other source identifier."
        },
        "migration_status": {
          "type": "string",
          "enum": ["NATIVE", "MIGRATED", "MERGED"]
        }
      }
    }
  }
}
