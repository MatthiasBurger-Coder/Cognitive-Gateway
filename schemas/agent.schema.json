{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-gateway.dev/schemas/agent.schema.json",
  "title": "Cognitive Gateway Agent Definition",
  "description": "The strict v2 contract for an Agent and its Skill references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "description", "skill_ids"],
  "properties": {
    "schema_version": { "const": 2 },
    "kind": { "const": "agent" },
    "id": { "$ref": "#/$defs/identifier" },
    "description": { "$ref": "#/$defs/description" },
    "skill_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "\\S"
    }
  }
}
