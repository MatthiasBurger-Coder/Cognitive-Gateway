{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-gateway.local/schemas/model-benchmark-dataset/1.0",
  "title": "Versioned local inference benchmark dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "description",
    "input_contract",
    "tasks",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "input_contract": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "classification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "output_contract",
            "system",
            "input_schema",
            "output_schema"
          ],
          "properties": {
            "output_contract": {
              "type": "string",
              "minLength": 1
            },
            "system": {
              "type": "string",
              "minLength": 1
            },
            "input_schema": {
              "type": "object"
            },
            "output_schema": {
              "type": "object"
            }
          }
        },
        "ranking": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "output_contract",
            "system",
            "input_schema",
            "output_schema"
          ],
          "properties": {
            "output_contract": {
              "type": "string",
              "minLength": 1
            },
            "system": {
              "type": "string",
              "minLength": 1
            },
            "input_schema": {
              "type": "object"
            },
            "output_schema": {
              "type": "object"
            }
          }
        },
        "extraction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "output_contract",
            "system",
            "input_schema",
            "output_schema"
          ],
          "properties": {
            "output_contract": {
              "type": "string",
              "minLength": 1
            },
            "system": {
              "type": "string",
              "minLength": 1
            },
            "input_schema": {
              "type": "object"
            },
            "output_schema": {
              "type": "object"
            }
          }
        },
        "matching": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "output_contract",
            "system",
            "input_schema",
            "output_schema"
          ],
          "properties": {
            "output_contract": {
              "type": "string",
              "minLength": 1
            },
            "system": {
              "type": "string",
              "minLength": 1
            },
            "input_schema": {
              "type": "object"
            },
            "output_schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "task",
          "input",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "task": {
            "enum": [
              "classification",
              "ranking",
              "extraction",
              "matching"
            ]
          },
          "input": {
            "type": "object"
          },
          "expected": {
            "type": "object"
          }
        }
      }
    }
  }
}
