{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-gateway.local/schemas/ml-experiment-v1",
  "title": "CG-28 CPU experiment plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_schema_version", "features", "top_k", "temperatures", "cv", "folds", "search", "seed", "budget", "objective", "stop_f1"],
  "properties": {
    "feature_schema_version": {"type": "string", "minLength": 1},
    "features": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "not": {"enum": ["label", "success", "failure", "outcome"]}}},
    "top_k": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "integer", "minimum": 1, "maximum": 64}},
    "temperatures": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "number", "exclusiveMinimum": 0}},
    "cv": {"enum": ["group", "chronological"]},
    "folds": {"type": "integer", "minimum": 2, "maximum": 10},
    "search": {"enum": ["grid", "random"]},
    "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "budget": {"type": "integer", "minimum": 1, "maximum": 128},
    "objective": {"const": "f1"},
    "stop_f1": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
  }
}
