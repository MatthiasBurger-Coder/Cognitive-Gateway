{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cognitive-gateway.local/schemas/learning.schema.json",
  "title": "Learning contract v1",
  "oneOf": [
    { "$ref": "#/$defs/pattern_candidate" },
    { "$ref": "#/$defs/learned_procedure" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$" },
    "digest": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "fingerprint_signal": {
      "oneOf": [
        { "type": "object", "required": ["kind", "value"], "properties": { "kind": { "const": "OPERATING_MODE" }, "value": { "enum": ["DEVELOPMENT", "HARDENING", "RELEASE_QUALIFICATION"] } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "value"], "properties": { "kind": { "const": "CAPABILITY" }, "value": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
        { "type": "object", "required": ["kind", "value"], "properties": { "kind": { "const": "FACT" }, "value": { "$ref": "#/$defs/id" } }, "additionalProperties": false }
      ]
    },
    "fingerprint": { "type": "object", "required": ["scope", "signals"], "properties": { "scope": { "$ref": "#/$defs/id" }, "signals": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/fingerprint_signal" } } }, "additionalProperties": false },
    "memory_reference": { "type": "object", "required": ["schema_version", "scope", "id", "revision", "eligibility_version", "source_snapshot", "source_digest"], "properties": { "schema_version": { "const": 1 }, "scope": { "$ref": "#/$defs/id" }, "id": { "$ref": "#/$defs/id" }, "revision": { "type": "integer", "minimum": 1 }, "eligibility_version": { "type": "integer", "minimum": 1 }, "source_snapshot": { "$ref": "#/$defs/id" }, "source_digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false },
    "experience_basis": { "type": "object", "required": ["memory", "provenance", "evaluation"], "properties": { "memory": { "$ref": "#/$defs/memory_reference" }, "provenance": { "$ref": "#/$defs/id" }, "evaluation": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
    "pattern_candidate": { "type": "object", "required": ["schema_version", "id", "fingerprint", "experience"], "properties": { "schema_version": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "fingerprint": { "$ref": "#/$defs/fingerprint" }, "experience": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/experience_basis" } } }, "additionalProperties": false },
    "process_reference": { "type": "object", "required": ["id", "version", "digest"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "integer", "minimum": 1 }, "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }, "additionalProperties": false },
    "procedure_step": { "type": "object", "required": ["process", "capability", "policy"], "properties": { "process": { "$ref": "#/$defs/process_reference" }, "capability": { "$ref": "#/$defs/id" }, "policy": { "$ref": "#/$defs/id" } }, "additionalProperties": false },
    "learned_procedure": { "type": "object", "required": ["schema_version", "id", "version", "source_candidate", "fingerprint", "experience", "steps", "required_observations", "required_evidence", "verification_evidence", "fallback", "digest"], "properties": { "schema_version": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "version": { "type": "integer", "minimum": 1 }, "source_candidate": { "$ref": "#/$defs/id" }, "fingerprint": { "$ref": "#/$defs/fingerprint" }, "experience": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/experience_basis" } }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/procedure_step" } }, "required_observations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "required_evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "verification_evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }, "fallback": { "enum": ["STOP", "RETURN_TO_PLANNER"] }, "digest": { "$ref": "#/$defs/digest" } }, "additionalProperties": false }
  }
}
