{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cg://contracts/2.0/response.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workspace_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "project_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "binding_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "workspace_id",
            "project_id",
            "binding_id"
          ]
        },
        "operation": {
          "enum": [
            "session.start",
            "session.inspect",
            "session.clarify",
            "session.approve",
            "session.continue",
            "session.cancel"
          ]
        },
        "correlation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            }
          },
          "required": [
            "request_id"
          ]
        },
        "status": {
          "const": "ok"
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "session": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "run": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "state": {
                  "enum": [
                    "runnable",
                    "dispatching",
                    "pending_clarification",
                    "pending_consent",
                    "cancelling",
                    "outcome_unknown",
                    "completed",
                    "failed",
                    "cancelled"
                  ]
                },
                "pending": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "issued_revision": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "expires_at_ms": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "id",
                        "issued_revision",
                        "expires_at_ms"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dispatch": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dispatch_knowledge": {
                  "enum": [
                    "none",
                    "prepared",
                    "reserved",
                    "verified",
                    "unknown",
                    "stopped"
                  ]
                },
                "command_outcome": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "command": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "session": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "revision": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "command",
                        "session",
                        "revision"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "final_evidence": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "revision": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "digest": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "id",
                        "revision",
                        "digest"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "session",
                "run",
                "revision",
                "state",
                "pending",
                "dispatch",
                "dispatch_knowledge",
                "command_outcome",
                "final_evidence"
              ]
            },
            "interaction": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "source"
                    },
                    "payload": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pending": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "issued_revision": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "expires_at_ms": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "id",
                            "issued_revision",
                            "expires_at_ms"
                          ]
                        },
                        "basis": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "revision": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "digest": {
                              "type": "string",
                              "pattern": "^sha256:[0-9a-f]{64}$"
                            }
                          },
                          "required": [
                            "id",
                            "revision",
                            "digest"
                          ]
                        },
                        "alternatives": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                              },
                              "revision": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                              },
                              "digest": {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              }
                            },
                            "required": [
                              "id",
                              "revision",
                              "digest"
                            ]
                          },
                          "maxItems": 256
                        }
                      },
                      "required": [
                        "pending",
                        "basis",
                        "alternatives"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "payload"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "consent"
                    },
                    "payload": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "owner": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "principal": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "workspace": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "project": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "binding": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "client_owner": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            }
                          },
                          "required": [
                            "principal",
                            "workspace",
                            "project",
                            "binding",
                            "client_owner"
                          ]
                        },
                        "session": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "run": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "pending": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "dispatch": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "step": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                        },
                        "issued_revision": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "expires_at_ms": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "action": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "revision": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "digest": {
                              "type": "string",
                              "pattern": "^sha256:[0-9a-f]{64}$"
                            }
                          },
                          "required": [
                            "id",
                            "revision",
                            "digest"
                          ]
                        },
                        "arguments": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "revision": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "digest": {
                              "type": "string",
                              "pattern": "^sha256:[0-9a-f]{64}$"
                            }
                          },
                          "required": [
                            "id",
                            "revision",
                            "digest"
                          ]
                        },
                        "artifact_basis": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "revision": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "digest": {
                              "type": "string",
                              "pattern": "^sha256:[0-9a-f]{64}$"
                            }
                          },
                          "required": [
                            "id",
                            "revision",
                            "digest"
                          ]
                        },
                        "authority": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "revision": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                            },
                            "digest": {
                              "type": "string",
                              "pattern": "^sha256:[0-9a-f]{64}$"
                            }
                          },
                          "required": [
                            "id",
                            "revision",
                            "digest"
                          ]
                        }
                      },
                      "required": [
                        "owner",
                        "session",
                        "run",
                        "pending",
                        "dispatch",
                        "step",
                        "issued_revision",
                        "expires_at_ms",
                        "action",
                        "arguments",
                        "artifact_basis",
                        "authority"
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "payload"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "budget": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "actions": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "retries": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "max_actions": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "max_retries": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10000
                },
                "deadline_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "actions",
                "retries",
                "max_actions",
                "max_retries",
                "deadline_ms"
              ]
            }
          },
          "required": [
            "session",
            "interaction",
            "budget"
          ]
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "schema_version",
        "scope",
        "operation",
        "correlation",
        "status",
        "result",
        "diagnostics"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "status": {
          "const": "error"
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "CG_INVALID_INPUT",
                  "CG_UNSUPPORTED_CAPABILITY",
                  "CG_UNSUPPORTED_VERSION",
                  "CG_SCOPE_DENIED",
                  "CG_SESSION_UNAVAILABLE",
                  "CG_DUPLICATE_COMMAND",
                  "CG_STALE_REVISION",
                  "CG_INVALID_SESSION_STATE",
                  "CG_INVALID_INTERACTION",
                  "CG_EXPIRED_INTERACTION",
                  "CG_CONSENT_REQUIRED",
                  "CG_POLICY_DENIED",
                  "CG_LIMIT_EXCEEDED",
                  "CG_OUTCOME_UNKNOWN",
                  "CG_STORAGE_UNAVAILABLE",
                  "CG_SENSITIVITY_DENIED",
                  "CG_TIMEOUT",
                  "CG_CANCELLED",
                  "CG_INTERNAL_ERROR"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "schema_version",
        "status",
        "diagnostics"
      ]
    }
  ]
}
