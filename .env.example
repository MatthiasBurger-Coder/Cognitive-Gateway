# Copy to ~/.config/cognitive-gateway/postgres.env and replace the password.
# scripts/start-postgres.sh creates that file with a random password if absent.
CG_POSTGRES_PASSWORD=replace-with-a-long-random-password
CG_POSTGRES_PORT=55432
# Optional: full image reference served by tiny-swarm-nexus-cache.
# CG_POSTGRES_IMAGE=tiny-swarm-nexus-cache.example/path/postgres:18
# CG_COMPOSE_PROJECT_NAME=cognitive-gateway
